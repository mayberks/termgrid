# ============================================
# TermGrid — .gitignore
# ============================================

# ---- Dependencies ----
node_modules/
jspm_packages/

# ---- Build output ----
dist/
out/
release/
build/Release/
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.snap

# ---- Generated icons (keep source SVG, ignore raster outputs) ----
build/icon.png
build/icon.ico

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Runtime / cache ----
.cache/
.parcel-cache/
.eslintcache
.electron-builder-cache/

# ---- Environment / secrets ----
.env
.env.local
.env.*.local

# ---- Editor / IDE ----
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
$RECYCLE.BIN/

# ---- Test / coverage ----
coverage/
.nyc_output/
*.lcov

# ---- Misc ----
.history/
.tmp/