{
  "name": "termgrid",
  "productName": "TermGrid",
  "version": "1.0.0",
  "description": "All your project terminals in one window, side by side. A grid-style panel for Windows.",
  "main": "src/main/index.js",
  "author": {
    "name": "TermGrid Contributors"
  },
  "license": "MIT",
  "homepage": "https://github.com/mayberks/termgrid#readme",
  "bugs": {
    "url": "https://github.com/mayberks/termgrid/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mayberks/termgrid.git"
  },
  "keywords": [
    "terminal",
    "cmd",
    "powershell",
    "grid",
    "panel",
    "electron",
    "developer-tools",
    "windows",
    "conpty",
    "xterm"
  ],
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/build-icons.js",
    "screenshots": "node scripts/build-screenshots.js",
    "prebuild": "node scripts/build-icons.js && node scripts/build-screenshots.js",
    "prepack": "node scripts/build-icons.js",
    "pack": "electron-builder --dir",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.termgrid.app",
    "productName": "TermGrid",
    "copyright": "Copyright © 2026 TermGrid Contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.*",
      "!**/*.md",
      "node_modules/**/*",
      "package.json",
      "LICENSE"
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "icon": "build/icon.ico",
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "pngjs": "^7.0.0",
    "to-ico": "^1.1.5"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}